---
const title = "grok-imessage";
const description =
  "Text your Grok Bot from iMessage. Open source. Spectrum carries the messages; your Bot keeps the memory.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0b0d10;
        --fg: #e8eaed;
        --muted: #9aa3ad;
        --accent: #f4f1ea;
        --line: #1c2229;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }
      body {
        font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
        background:
          radial-gradient(1200px 600px at 20% -10%, #1a2430 0%, transparent 55%),
          radial-gradient(900px 500px at 100% 0%, #152018 0%, transparent 45%),
          var(--bg);
        color: var(--fg);
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        padding: 22vh 1.5rem 4rem;
      }
      .brand {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        text-transform: lowercase;
        color: var(--accent);
        margin: 0 0 1.25rem;
      }
      h1 {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 500;
        font-size: clamp(2.1rem, 5vw, 3rem);
        line-height: 1.15;
        margin: 0 0 1rem;
      }
      p {
        margin: 0 0 1.75rem;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.55;
        max-width: 34rem;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
      }
      a {
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.1rem;
      }
      a:hover {
        border-bottom-color: var(--fg);
      }
      .primary {
        border: 1px solid var(--fg);
        padding: 0.55rem 0.9rem;
        border-radius: 2px;
      }
      .primary:hover {
        background: var(--fg);
        color: var(--bg);
        border-bottom-color: transparent;
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <p class="brand">grok-imessage</p>
      <h1>Your Grok Bot, over iMessage.</h1>
      <p>
        Open-source bridge: Spectrum delivers the texts, a tiny always-on service wakes your
        existing Grok Bot, and the reply comes back as a blue bubble. Memory stays on the Bot.
      </p>
      <div class="actions">
        <a class="primary" href="https://photon.codes/docs/spectrum-ts">Spectrum docs</a>
        <a href="https://cursor.com/docs/grok-bot">Grok Bot</a>
      </div>
    </main>
  </body>
</html>
