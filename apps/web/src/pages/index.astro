---
import Site from "../layouts/Site.astro";
import BotFace from "../components/BotFace.astro";
import { clockFor, conversations, traceFor } from "../data/conversations";

const repo = "https://github.com/Hanif-adedotun/grok-imessage";

const title = "grok-imessage — text your Grok Bot from iMessage";
const description =
  "An open-source bridge: Spectrum delivers the texts, a small always-on service wakes your Grok Bot, and the answer comes back in the thread.";

const opening = conversations[0]!;
const trace = traceFor(opening);
const clock = clockFor(opening);

const modes = [
  { name: "HTTP only", env: "no Spectrum credentials", does: "/health and /reply listen" },
  { name: "Echo", env: "PROJECT_ID + PROJECT_SECRET", does: "inbound text echoed back" },
  { name: "Wake", env: "+ GROK_BOT_WEBHOOK_*", does: "wakes the Bot, reply via POST /reply" },
];
---

<Site title={title} description={description}>
    <main>
      <section class="hero" data-thread-window data-log-state="idle" data-compose-state="idle">
        <div class="hero-text">
          <a class="pill enter" href="https://x.ai/bot" data-cuelume-tap>
            <strong>An extension for Grok Bot</strong>
            <span class="pill-sep" aria-hidden="true">•</span>
            <span>Meet Grok Bot</span>
            <span class="pill-arrow" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10">
                <path d="M3 7 7 3M3.5 3H7v3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <h1 class="enter">Text your <BotFace class="h1-face" /> Grok Bot from iMessage</h1>
          <p class="lede enter">
            Spectrum takes the message off your line, the bridge wakes your Bot's routine, and the
            answer arrives in the same thread. Memory, skills and the cloud computer stay on the
            Bot.
          </p>
          <div class="actions enter">
            <a class="btn btn-primary" href={repo} data-cuelume-tap>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
                ></path>
              </svg>
              View on GitHub
            </a>
            <a
              class="btn btn-secondary"
              href="/docs/"
              data-cuelume-navigate
              data-cuelume-emphasis="subtle">Read the docs</a
            >
          </div>
          <p class="meta enter">MIT · Bun and TypeScript · scaffold on main</p>
          <div class="log">
            <p class="log-head">
              <span>bridge log</span>
              <span class="log-meta">
                <span class="log-status">
                  <span class="log-dot" aria-hidden="true"></span>
                  <span data-log-status>idle</span>
                </span>
                <button class="replay" type="button" data-replay data-cuelume-tap data-cuelume-emphasis="subtle">
                  Replay
                </button>
              </span>
            </p>
            <ol class="trace">
              {
                trace.map((row) => (
                  <li data-log-row>
                    <time>{row.at}</time>
                    <span class="actor">{row.actor}</span>
                    <span class="event">{row.event}</span>
                    <span class="delta">{row.delta}</span>
                  </li>
                ))
              }
            </ol>
            <span class="caret" aria-hidden="true"></span>
          </div>
        </div>

        <div class="stage">

          <figure class="phone" data-phone>
            <span class="island" aria-hidden="true"></span>

            <div class="screen">
              <div class="statusbar" aria-hidden="true">
                <span data-clock>{clock}</span>
                <span class="indicators">
                  <svg width="15" height="10" viewBox="0 0 15 10" fill="currentColor">
                    <rect x="0" y="6" width="3" height="4" rx="1"></rect>
                    <rect x="4" y="4" width="3" height="6" rx="1"></rect>
                    <rect x="8" y="2" width="3" height="8" rx="1"></rect>
                    <rect x="12" y="0" width="3" height="10" rx="1"></rect>
                  </svg>
                  <svg width="13" height="10" viewBox="0 0 13 10" fill="currentColor">
                    <path d="M6.5 8.6 4.9 6.9a2.4 2.4 0 0 1 3.2 0z"></path>
                    <path d="M6.5 3.1c1.5 0 2.9.6 3.9 1.6l-1 1.1a4.1 4.1 0 0 0-5.8 0l-1-1.1a5.5 5.5 0 0 1 3.9-1.6z"></path>
                    <path d="M6.5 0c2.3 0 4.4 1 5.9 2.5l-1 1.1a6.9 6.9 0 0 0-9.8 0L.6 2.5A8.2 8.2 0 0 1 6.5 0z"></path>
                  </svg>
                  <svg width="22" height="11" viewBox="0 0 22 11" fill="currentColor">
                    <rect x=".5" y=".5" width="18" height="10" rx="3" fill="none" stroke="currentColor" stroke-opacity=".45"></rect>
                    <rect x="2" y="2" width="12" height="7" rx="1.8"></rect>
                    <path d="M20 4v3a1.6 1.6 0 0 0 0-3z" fill-opacity=".45"></path>
                  </svg>
                </span>
              </div>

              <figcaption class="appbar">
                <svg class="appbar-back" width="8" height="14" viewBox="0 0 8 14" aria-hidden="true">
                  <path d="M7 1 1 7l6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="avatar" aria-hidden="true"><BotFace /></span>
                <span class="appbar-name">Grok Bot</span>
              </figcaption>

              <div class="thread" data-thread>
                <p class="day">iMessage · Today <span data-day>{clock}</span></p>
                <div class="bubble out" data-step="out">{opening.question}</div>
                <p class="receipt" data-step="receipt">Delivered</p>
                <div class="bubble in typing" data-step="typing" aria-hidden="true" hidden>
                  <span class="dot" data-dot></span>
                  <span class="dot" data-dot></span>
                  <span class="dot" data-dot></span>
                </div>
                <div class="bubble in" data-step="in">{opening.reply}</div>
              </div>

              <div class="compose" aria-hidden="true">
                <span class="field">
                  <span class="compose-text" data-compose></span><span class="compose-caret"></span>
                </span>
                <span class="send">
                  <svg width="14" height="14" viewBox="0 0 24 24">
                    <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </div>
            </div>
          </figure>
        </div>

      </section>

      <section class="run" id="run">
        <div>
          <h2>Run the bridge</h2>
          <p>
            Clone the repo, drop your Spectrum credentials into <code>.env</code>, and start the
            two processes. How much the bridge does depends on what you fill in.
          </p>
          <pre><code><span class="cmd">git clone {repo}</span>
<span class="cmd">cd grok-imessage && bun install</span>
<span class="cmd">cp .env.example .env</span>

<span class="cmd">bun run dev:bridge</span>
<span class="cmd">bun run dev:web</span></code></pre>
        </div>

        <div class="modes">
          {
            modes.map((mode) => (
              <div class="mode">
                <span class="mode-name">{mode.name}</span>
                <span class="mode-env">{mode.env}</span>
                <span class="mode-does">{mode.does}</span>
              </div>
            ))
          }
        </div>
      </section>
    </main>
</Site>

<style>
      /* Hero */

      .hero {
        min-height: calc(100svh - 200px);
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        align-items: center;
        gap: 64px;
        padding: 48px 0 128px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        max-width: 100%;
        margin-bottom: 20px;
        padding: 6px 6px 6px 12px;
        border-radius: 9999px;
        background: rgba(26, 26, 26, 0.6);
        font-size: 13px;
        letter-spacing: -0.01em;
        white-space: nowrap;
        transition: background-color 150ms var(--ease);
      }

      .pill:hover {
        background: var(--raised);
      }

      .pill strong {
        font-weight: 600;
      }

      .pill-sep {
        color: rgba(255, 255, 255, 0.3);
      }

      .pill-arrow {
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--raised-2);
      }

      h1 {
        margin: 0 0 20px;
        font-size: clamp(40px, 5vw, 60px);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.01em;
        max-width: 14ch;
        text-wrap: balance;
      }

      h1 :global(.h1-face) {
        width: 0.92em;
        height: 0.92em;
        margin: 0 0.02em;
        vertical-align: -0.12em;
      }

      .lede {
        margin: 0 0 32px;
        max-width: 34rem;
        font-size: 18px;
        line-height: 1.625;
        color: var(--fg-3);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .meta {
        margin: 24px 0 0;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--fg-3);
      }

      /* Phone */

      .stage {
        perspective: 1200px;
      }

      .phone {
        --phone-w: 330px;
        position: relative;
        z-index: 1;
        width: var(--phone-w);
        margin: 0 auto;
        padding: 10px;
        border-radius: 48px;
        background: linear-gradient(155deg, #2a2a2a, #0f0f0f);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.1),
          0 0 0 1px rgba(255, 255, 255, 0.06),
          0 24px 60px rgba(0, 0, 0, 0.6);
        transform-style: preserve-3d;
      }

      .screen {
        display: flex;
        flex-direction: column;
        /* Screen proportion that puts the whole device at a current iPhone's 2.17 */
        aspect-ratio: 1 / 2.24;
        border-radius: 38px;
        background: var(--deep);
        overflow: hidden;
        --face-eye: var(--deep);
      }

      .island {
        position: absolute;
        top: 22px;
        left: 50%;
        z-index: 2;
        width: 100px;
        height: 28px;
        margin-left: -50px;
        border-radius: 14px;
        background: #05060a;
      }

      .statusbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 52px;
        padding: 0 22px 0 24px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--fg-2);
      }

      .indicators {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--fg-3);
      }

      .appbar {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 2px 0 10px;
        border-bottom: 1px solid var(--line);
      }

      .appbar-back {
        position: absolute;
        left: 20px;
        top: 14px;
        color: var(--fg-3);
      }

      .avatar {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        color: var(--fg);
      }

      .avatar :global(.bot-face) {
        width: 100%;
        height: 100%;
      }

      .appbar-name {
        font-size: 12px;
        color: var(--fg-2);
      }

      /* Thread */

      .thread {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 7px;
        padding: 14px;
        overflow: hidden;
      }

      .day {
        margin: 0 0 8px;
        text-align: center;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--fg-3);
      }

      .bubble {
        max-width: 82%;
        padding: 9px 14px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.42;
      }

      .bubble.out {
        align-self: flex-end;
        background: var(--imessage);
        color: #ffffff;
        border-bottom-right-radius: 5px;
        transform-origin: 100% 100%;
      }

      .bubble.in {
        align-self: flex-start;
        background: #262628;
        color: var(--fg);
        border-bottom-left-radius: 5px;
        transform-origin: 0% 100%;
      }

      .typing {
        display: flex;
        align-items: center;
        gap: 5px;
        width: max-content;
        padding: 12px;
      }

      .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--fg-3);
      }

      .receipt {
        margin: 0;
        align-self: flex-end;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--fg-3);
      }

      /* Compose bar */

      .compose {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 12px 14px 20px;
        border-top: 1px solid var(--line);
      }

      .field {
        flex: 1;
        min-width: 0;
        min-height: 34px;
        padding: 7px 12px;
        border: 1px solid var(--line-strong);
        border-radius: 17px;
        font-size: 14px;
        line-height: 20px;
        color: var(--fg);
      }

      .compose-text:empty::before {
        content: "iMessage";
        color: var(--fg-3);
      }

      .compose-caret {
        display: inline-block;
        vertical-align: text-bottom;
        width: 2px;
        height: 16px;
        margin-left: 1px;
        background: var(--imessage);
        opacity: 0;
      }

      [data-compose-state="typing"] .compose-caret {
        opacity: 1;
      }

      .send {
        flex: none;
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--raised);
        color: var(--fg-3);
        transition:
          background-color 160ms var(--ease),
          color 160ms var(--ease);
      }

      [data-compose-state="typing"] .send {
        background: var(--imessage);
        color: #ffffff;
      }

      /* Bridge log, sitting behind the phone */

      .log {
        max-width: 34rem;
        margin-top: 40px;
        padding: 16px 18px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
      }

      .log-head {
        margin: 0 0 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--fg-3);
      }

      .log-meta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }

      .log-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .log-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--fg-3);
        transition: background-color 200ms var(--ease);
      }

      [data-log-state="streaming"] .log-dot {
        background: var(--accent);
      }

      .replay {
        padding: 3px 9px;
        border: 0;
        border-radius: 9999px;
        background: var(--raised);
        font-family: var(--mono);
        font-size: 11px;
        color: var(--fg-3);
        cursor: pointer;
        transition:
          color 150ms var(--ease),
          border-color 150ms var(--ease),
          transform 120ms var(--ease);
      }

      .replay:hover {
        color: var(--fg);
        background: var(--raised-2);
      }

      .replay:active {
        transform: scale(0.98);
      }

      .caret {
        display: block;
        width: 6px;
        height: 12px;
        margin-top: 8px;
        background: var(--fg-3);
        opacity: 0;
        transition: opacity 150ms var(--ease);
      }

      [data-log-state="streaming"] .caret {
        opacity: 1;
      }

      .trace {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 4px 10px;
        font-family: var(--mono);
        font-size: 11px;
        font-variant-numeric: tabular-nums;
      }

      .trace li {
        display: contents;
      }

      .trace time {
        color: var(--fg-3);
      }

      .trace .actor {
        color: var(--fg);
      }

      .trace .event {
        color: var(--fg-2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .trace .delta {
        color: var(--fg-3);
        text-align: right;
      }


      /* Run it */

      .run {
        padding-bottom: 96px;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: start;
        gap: 64px;
      }

      h2 {
        margin: 0 0 12px;
        font-size: 36px;
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: -0.01em;
      }

      .run p {
        margin: 0;
        max-width: 34rem;
        font-size: 16px;
        line-height: 1.625;
        color: var(--fg-3);
      }

      pre {
        margin: 24px 0 0;
        padding: 20px 24px;
        overflow-x: auto;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.75;
        color: var(--fg-2);
      }

      pre .cmd {
        color: var(--fg);
      }

      .modes {
        margin: 0;
        display: grid;
        gap: 8px;
      }

      .mode {
        display: grid;
        gap: 4px;
        padding: 18px 22px;
        border-radius: 20px;
        background: var(--raised);
      }

      .mode-name {
        font-size: 15px;
        font-weight: 500;
      }

      .mode-env {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--fg-3);
      }

      .mode-does {
        font-size: 14px;
        color: var(--fg-3);
      }

      /* Narrow desktop: shrink the phone so the log keeps its room */

      @media (max-width: 1100px) and (min-width: 901px) {
        .phone {
          --phone-w: 282px;
        }
      }

      @media (max-width: 900px) {
        .hero,
        .run {
          grid-template-columns: minmax(0, 1fr);
          gap: 48px;
        }

        .hero {
          min-height: 0;
          padding: 24px 0 64px;
        }

        /* Phone leads on mobile; copy follows. */
        .stage {
          order: -1;
        }

        .phone {
          --phone-w: min(280px, 72vw);
          margin: 0 auto;
        }

        .log {
          margin-top: 32px;
        }

        h1 {
          max-width: 14ch;
        }

        .lede {
          font-size: 17px;
        }

        .run pre {
          padding: 16px;
          font-size: 12px;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          white-space: pre-wrap;
          overflow-wrap: anywhere;
        }
      }

      @media (max-width: 520px) {
        .actions .btn {
          width: 100%;
        }

        .pill-sep,
        .pill-sep + span {
          display: none;
        }

        .run pre {
          padding: 14px;
          font-size: 11px;
          line-height: 1.7;
        }
      }
</style>
