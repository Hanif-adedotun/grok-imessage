# Spectrum Cloud — https://app.photon.codes
# Both required to open the message loop; omit both for HTTP-only.
PROJECT_ID=
PROJECT_SECRET=

# Public origin of this bridge (no trailing slash). Required when wake is enabled.
BRIDGE_PUBLIC_BASE_URL=https://your-bridge.example.com

# Grok Bot routine webhook (desktop routine panel). Set both or neither.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=

# Optional: comma-separated iMessage handles / user ids allowed to wake the Bot
ALLOWED_SENDERS=

# Optional: pepper for hashing one-shot reply tokens
REPLY_TOKEN_PEPPER=

# HTTP listen port for /health and /reply
PORT=3000
